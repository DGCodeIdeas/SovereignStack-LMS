{% extends 'base.html.twig' %}

{% block title %}Users — SovereignStack LMS{% endblock %}

{% block body %}
    <section class="panel">
        <h1>User administration</h1>

        <form method="get" action="{{ path('app_admin_users') }}" class="form">
            <div class="form-field">
                <label for="q">Search by email or display name</label>
                <input id="q" name="q" type="search" value="{{ query }}" maxlength="255">
            </div>
            <div class="form-field">
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="">Any status</option>
                    {% for state in ['active', 'pending_verification', 'suspended', 'deactivated'] %}
                        <option value="{{ state }}" {{ status == state ? 'selected' : '' }}>{{ state }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-field">
                <label for="role">Role</label>
                <select id="role" name="role">
                    <option value="">Any role</option>
                    {% for roleOption in roles %}
                        <option value="{{ roleOption.code }}" {{ role == roleOption.code ? 'selected' : '' }}>{{ roleOption.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="button">Search</button>
        </form>

        <p>{{ total }} user{{ total == 1 ? '' : 's' }} found.</p>

        <table>
            <caption>User accounts</caption>
            <thead>
                <tr>
                    <th scope="col">Email</th>
                    <th scope="col">Display name</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created</th>
                    <th scope="col">Last login</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.displayName is not empty ? user.displayName : '—' }}</td>
                        <td>{{ user.status }}</td>
                        <td>{{ user.createdAt }}</td>
                        <td>{{ user.lastLoginAt ?? '—' }}</td>
                        <td><a href="{{ path('app_admin_user_show', {id: user.id}) }}">Open</a></td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">No users found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <nav aria-label="User list pages" class="form-links">
            {% if page > 1 %}
                <a href="{{ path('app_admin_users', {q: query, status: status, role: role, page: page - 1}) }}">Previous</a>
            {% endif %}
            <span>Page {{ page }}</span>
            {% if page * 50 < total %}
                <a href="{{ path('app_admin_users', {q: query, status: status, role: role, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    </section>
{% endblock %}