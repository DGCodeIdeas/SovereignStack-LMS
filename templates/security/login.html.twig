{% extends 'base.html.twig' %}

{% block title %}Sign in - SovereignStack LMS{% endblock %}

{% block body %}
    <h1>Sign in</h1>

    {% if error %}
        <div class="alert alert-error" role="alert">{{ error.message }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" class="form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="form-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" value="{{ last_username }}" autocomplete="email" required autofocus>
        </div>

        <div class="form-field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>

        <button type="submit" class="button">Sign in</button>
    </form>

    <p class="form-links">
        <a href="{{ path('app_register') }}">Create an account</a>
        <a href="{{ path('app_request_password_reset') }}">Forgot your password?</a>
    </p>
{% endblock %}
