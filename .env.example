# Default environment configuration
APP_ENV=dev
APP_DEBUG=1

# Database configuration (primary: MySQL 8.4 / alternative: MariaDB 12.3)
# Format: mysql:// or mariadb://
DATABASE_URL="mysql://lms_user:lms_password@127.0.0.1:3306/lms?charset=utf8mb4"

# Test database (overridden by CI for each engine)
TEST_DATABASE_URL="mysql://lms_test:lms_test@127.0.0.1:3306/lms_test?charset=utf8mb4"

# Messenger transport
MESSENGER_TRANSPORT_DSN="doctrine://default"

# Mailer (dev: disabled)
MAILER_DSN="null://null"
