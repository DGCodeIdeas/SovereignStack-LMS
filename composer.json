{
    "name": "sovereignstack/lms",
    "description": "SovereignStack Learning Management System - Standalone LMS extracted from DGLab",
    "type": "project",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/password-hasher": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/messenger": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/migrations": "^3.8",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/doctrine-messenger": "^7.4",
        "monolog/monolog": "^3.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/clock": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/options-resolver": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/string": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/type-info": "^7.4",
        "symfony/var-exporter": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-doctrine": "^1.3",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/process": "^7.4",
        "symfony/maker-bundle": "^1.50",
        "symfony/var-dumper": "^7.4",
        "symfony/stopwatch": "^7.4",
        "friendsofphp/php-cs-fixer": "^3.65",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "SovereignStack\\Lms\\": "src/",
            "SovereignStack\\Lms\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SovereignStack\\Lms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit --testsuite architecture",
        "test:unit": "phpunit --testsuite unit",
        "test:architecture": "phpunit --testsuite architecture",
        "test:integration": "phpunit --testsuite integration",
        "static-analysis": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}